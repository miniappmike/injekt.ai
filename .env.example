NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes, base64: openssl rand -base64 32
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=1
# shared secret used to verify provider webhooks
WEBHOOK_SECRET=
# random string of 16+ characters; Vercel Cron sends it so only it can run the daily cleanup
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Platform SpicyAPI key. Used for the one free image each free account gets (after email confirmation),
# and as a fallback for admin accounts. Never used for anything else.
SPICY_API_KEY=
# optional, in-memory limiter is used when unset
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
